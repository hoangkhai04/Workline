# ==== Server ====
PORT=4000
JWT_SECRET=doi_chuoi_bi_mat_nay_thanh_chuoi_ngau_nhien_dai
FRONTEND_URL=http://localhost:5500

# ==== Google Drive (luu du lieu) ====
# Dan nguyen noi dung file JSON key cua Service Account vao day (1 dong, dung dau ngoac kep)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}
# ID cua thu muc Google Drive da share cho Service Account (lay trong URL thu muc)
GOOGLE_DRIVE_FOLDER_ID=
# Ten file du lieu tren Drive (tuy chon, mac dinh workline-db.json)
GOOGLE_DRIVE_DB_FILENAME=workline-db.json

# ==== Email (SMTP) ====
# Vi du dung Gmail: bat "2-Step Verification" roi tao "App Password" 16 ky tu tai
# https://myaccount.google.com/apppasswords -- KHONG dung mat khau Gmail thuong.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ten.ban@gmail.com
SMTP_PASS=app_password_16_ky_tu
MAIL_FROM="Workline" <ten.ban@gmail.com>
